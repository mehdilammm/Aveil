# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://jhbdoyrltshpiczpgifb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: comma separated emails allowed to open /api/health (default: any signed-in user)
ADMIN_EMAILS=

# Weekly scheduled scans (Vercel Cron). Any long random string, e.g. openssl rand -hex 32.
# Without it, /api/cron/weekly-scans refuses to run.
CRON_SECRET=

# AI Visibility (server only). GEMINI_MODEL is optional; default gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=

# Second AI Visibility engine (server only). MISTRAL_MODEL is optional; default mistral-medium-latest.
MISTRAL_API_KEY=
MISTRAL_MODEL=
